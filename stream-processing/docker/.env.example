# Copy to .env (gitignored) in this folder; the alerting service reads it.
# Leave a line empty to switch that channel off. Never commit the real URLs:
# anyone holding a webhook URL can post to the channel.
#
# Discord: channel settings -> Integrations -> Webhooks -> New Webhook -> Copy Webhook URL
DISCORD_WEBHOOK_URL=
# Slack: an app with Incoming Webhooks enabled -> Add New Webhook to Workspace
SLACK_WEBHOOK_URL=
